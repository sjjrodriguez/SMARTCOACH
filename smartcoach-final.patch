+def level_from_label(label):
+    """Map a stored plan label back to its level (0, 1, 2)."""
+    if label in _LABEL_TO_LEVEL:
+        return _LABEL_TO_LEVEL[label]
+    for lvl, name in LEVEL_NAMES.items():
+        if (label or '').startswith(name):
+            return lvl
+    return 0
