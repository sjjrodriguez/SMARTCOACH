+{# Shared by create.html and edit.html.
+   Expects: v (dict of current values), submit_label. #}
+<form method="POST">
+    <div class="row">
+        <div class="col-md-6 mb-3">
+            <label for="date" class="form-label">Date</label>
+            <input type="date" id="date" name="date" class="form-control"
+                   value="{{ v.get('date', '') }}" required>
+        </div>
+        <div class="col-md-6 mb-3">
+            <label for="duration_min" class="form-label">Duration (min)</label>
+            <input type="number" id="duration_min" name="duration_min" min="1" max="1440" step="1"
+                   class="form-control" value="{{ v.get('duration_min', '') }}" required>
+        </div>
+        <div class="col-md-6 mb-3">
+            <label for="distance_km" class="form-label">Distance (km)</label>
+            <input type="number" id="distance_km" name="distance_km" min="0" max="1000" step="0.1"
+                   class="form-control" value="{{ v.get('distance_km', '') }}" required>
+        </div>
+        <div class="col-md-6 mb-3">
+            <label for="elevation_gain_m" class="form-label">Elevation gain (m)</label>
+            <input type="number" id="elevation_gain_m" name="elevation_gain_m" min="0" max="20000" step="1"
+                   class="form-control" value="{{ v.get('elevation_gain_m', 0) }}">
+        </div>
+        <div class="col-md-6 mb-3">
+            <label for="rpe" class="form-label">Effort / RPE (1-10)</label>
+            <input type="number" id="rpe" name="rpe" min="1" max="10" step="1" class="form-control"
+                   value="{{ v.get('rpe', '') }}" aria-describedby="rpe-help" required>
+            <div id="rpe-help" class="form-text">1 = very easy, 10 = maximal effort.</div>
+        </div>
+        <div class="col-md-6 mb-3">
+            <label for="perceived_fatigue" class="form-label">Perceived fatigue (1-10)</label>
+            <input type="number" id="perceived_fatigue" name="perceived_fatigue" min="1" max="10" step="1"
+                   class="form-control" value="{{ v.get('perceived_fatigue', 1) }}" aria-describedby="fatigue-help" required>
+            <div id="fatigue-help" class="form-text">1 = feeling fresh, 10 = completely exhausted.</div>
+        </div>
+        <div class="col-12 mb-3">
+            <label for="notes" class="form-label">Notes <span class="text-secondary fw-normal">(optional)</span></label>
+            <textarea id="notes" name="notes" rows="3" class="form-control"
+                      placeholder="How did the ride feel? Any pain or discomfort?">{{ v.get('notes', '') }}</textarea>
+        </div>
+    </div>
+    <p class="sc-note mt-0 mb-3">The training load (TSS) is estimated automatically from duration and effort.</p>
+    <div class="d-flex gap-2">
+        <button type="submit" class="btn btn-primary">{{ submit_label }}</button>
+        <a href="{{ url_for('workouts.list_workouts') }}" class="btn btn-outline-secondary">Cancel</a>
+    </div>
+</form>
