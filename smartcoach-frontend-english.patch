+    <div class="col-md-9 col-lg-7">
+        <div class="card">
+            <div class="card-body">
+                <h1 class="sc-h1 mb-1">Log a workout</h1>
+                <p class="sc-note mb-4">Record a training session to keep your load and risk level up to date.</p>
