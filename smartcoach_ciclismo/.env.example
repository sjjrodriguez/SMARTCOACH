# Copy this file to .env and fill it in. The .env file is ignored by git: never commit it.

# Long random value that signs the session cookie.
SECRET_KEY=change-this-in-production

# Database. Leave it like this for a local SQLite file, or use your Supabase/PostgreSQL address:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:6543/postgres
DATABASE_URL=sqlite:///smartcoach.db

# 1 = debug mode when you run `python run.py` (development only).
FLASK_DEBUG=0
